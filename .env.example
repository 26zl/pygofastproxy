# Backend target and proxy listen port
PY_BACKEND_TARGET=http://localhost:4000  # set to http://backend:4000 when using docker-compose
PY_BACKEND_PORT=8080

# Performance and timeouts
PROXY_MAX_CONNS_PER_HOST=1000
PROXY_READ_TIMEOUT=10s
PROXY_WRITE_TIMEOUT=10s
PROXY_MAX_IDLE_CONN_DURATION=60s

# Limits and CORS
PROXY_RATE_LIMIT_RPS=1000        # set 0 to disable
PROXY_MAX_REQUEST_BODY_SIZE=10485760
ALLOWED_ORIGINS=
