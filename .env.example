# Backend target and proxy listen port
PY_BACKEND_TARGET=http://localhost:4000
PY_BACKEND_PORT=8080

# Performance and timeouts
PROXY_MAX_CONNS_PER_HOST=1000
PROXY_MAX_CONN_WAIT_TIMEOUT=5s
PROXY_READ_TIMEOUT=10s
PROXY_WRITE_TIMEOUT=10s
PROXY_MAX_IDLE_CONN_DURATION=60s
PROXY_READ_BUFFER_SIZE=16384
PROXY_WRITE_BUFFER_SIZE=16384

# Rate limiting and request limits
PROXY_RATE_LIMIT_RPS=1000            # per-IP, set 0 to disable
PROXY_MAX_REQUEST_BODY_SIZE=10485760  # 10MB

# CORS
ALLOWED_ORIGINS=
PROXY_CORS_ALLOW_CREDENTIALS=false

# TLS (leave empty to disable)
PROXY_TLS_CERT_FILE=
PROXY_TLS_KEY_FILE=
